<Project Sdk="Microsoft.NET.Sdk">

  <!-- Entry assembly run by test_script_runtime as scripts/OpenMT2.Scripts.dll. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(NeoeterDotNetDir)/managed/Neoeter.Scripting/Neoeter.Scripting.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
